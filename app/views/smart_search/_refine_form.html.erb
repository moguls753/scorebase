<div id="refine-form" class="mm-card mt-6 p-4">
  <% if local_assigns[:blank_error] %>
    <p class="mb-2 text-xs text-amber-400"><%= t("smart_search.refine.blank_error") %></p>
  <% end %>
  <%= form_with url: refine_smart_search_path, method: :post, class: "flex flex-col sm:flex-row sm:items-center gap-3", data: { turbo: true } do |f| %>
    <%= hidden_field_tag :parent_query_id, query_record.id %>
    <input type="text" name="refinement" maxlength="300"
           placeholder="<%= t('smart_search.refine.placeholder') %>"
           class="h-20 sm:h-14 flex-1 rounded-sm border-2 border-[var(--color-border)] bg-[var(--color-bg)] px-4 text-base text-[var(--color-text)] placeholder-[var(--color-text-muted)] focus:border-[var(--color-accent)] focus:outline-none">
    <button type="submit"
            class="mm-button mm-button-primary h-14 w-full sm:w-auto inline-flex items-center justify-center"
            data-turbo-submits-with='<svg class="smart-search-spinner inline-block w-4 h-4 mr-2 align-middle" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="9" stroke-opacity="0.2"/><path d="M12 3a9 9 0 0 1 9 9"/></svg><%= t("smart_search.refine.refining") %>'>
      <span class="sm:hidden"><%= t("smart_search.refine.button_mobile") %></span>
      <span class="hidden sm:inline"><%= t("smart_search.refine.button") %></span>
    </button>
  <% end %>
</div>
