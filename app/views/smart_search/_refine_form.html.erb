<div id="refine-form" class="mt-6">
  <% if local_assigns[:blank_error] %>
    <p class="mb-2 text-sm text-amber-300"><%= t("smart_search.refine.blank_error") %></p>
  <% end %>
  <%= form_with url: refine_smart_search_path, method: :post, class: "flex items-stretch gap-2", data: { turbo: true } do |f| %>
    <%= hidden_field_tag :parent_query_id, query_record.id %>
    <input type="text" name="refinement" maxlength="300"
           placeholder="<%= t('smart_search.refine.placeholder') %>"
           class="flex-1 px-4 py-2 text-sm bg-[var(--color-bg-elevated)] border border-[var(--color-border)] rounded-lg text-[var(--color-text)] placeholder-[var(--color-text-muted)] focus:outline-none focus:border-[var(--color-accent)]" />
    <button type="submit"
            class="px-4 py-2 text-sm font-medium bg-[var(--color-accent)] text-white rounded-lg hover:bg-[var(--color-accent)]/90 transition-colors"
            data-turbo-submits-with="<%= t('smart_search.refine.refining') %>">
      <%= t("smart_search.refine.button") %>
    </button>
  <% end %>
</div>
