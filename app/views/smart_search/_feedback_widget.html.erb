<div id="feedback-widget" class="mt-8 p-4 bg-[var(--color-bg-elevated)] border border-[var(--color-border)] rounded-lg">
  <p class="text-sm text-[var(--color-text-secondary)] mb-3">
    <%= t("smart_search.feedback.prompt") %>
  </p>
  <%= form_with url: feedback_smart_search_path, method: :post, class: "flex items-center gap-3", data: { turbo: true } do |f| %>
    <%= hidden_field_tag :query_id, query_record.id %>
    <button type="submit" name="verdict" value="good"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium bg-[var(--color-accent)]/10 text-[var(--color-accent)] rounded-lg hover:bg-[var(--color-accent)]/20 transition-colors"
            data-turbo-submits-with="<%= t('smart_search.feedback.sending') %>">
      👍 <%= t("smart_search.feedback.good") %>
    </button>
    <button type="submit" name="verdict" value="bad"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium bg-[var(--color-bg)]/50 text-[var(--color-text-secondary)] rounded-lg hover:bg-[var(--color-bg)] transition-colors"
            data-turbo-submits-with="<%= t('smart_search.feedback.sending') %>">
      👎 <%= t("smart_search.feedback.bad") %>
    </button>
    <input type="text" name="comment" maxlength="1000"
           placeholder="<%= t('smart_search.feedback.comment_placeholder') %>"
           class="flex-1 px-3 py-1.5 text-sm bg-[var(--color-bg)] border border-[var(--color-border)] rounded-lg text-[var(--color-text)] placeholder-[var(--color-text-muted)] focus:outline-none focus:border-[var(--color-accent)]" />
  <% end %>
</div>
