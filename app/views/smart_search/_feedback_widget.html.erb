<div id="feedback-widget" class="mm-card mt-8 p-3">
  <%= form_with url: feedback_smart_search_path, method: :post, class: "flex flex-wrap items-center gap-3", data: { turbo: true } do |f| %>
    <%= hidden_field_tag :query_id, query_record.id %>
    <span class="text-sm text-[var(--color-text-muted)]">
      <%= t("smart_search.feedback.prompt") %>
    </span>
    <button type="submit" name="verdict" value="good"
            class="inline-flex items-center gap-1.5 rounded-sm border-2 border-[var(--color-border)] px-2.5 py-1 text-sm font-medium text-[var(--color-text-muted)] transition-all hover:border-[var(--color-accent)]/50 hover:bg-[var(--color-bg)] hover:text-[var(--color-text)]"
            data-turbo-submits-with="<%= t('smart_search.feedback.sending') %>">
      <%= lucide_icon "thumbs-up", class: "w-3.5 h-3.5", "stroke-width": 2 %>
      <%= t("smart_search.feedback.good") %>
    </button>
    <button type="submit" name="verdict" value="bad"
            class="inline-flex items-center gap-1.5 rounded-sm border-2 border-[var(--color-border)] px-2.5 py-1 text-sm font-medium text-[var(--color-text-muted)] transition-all hover:border-red-500/60 hover:bg-[var(--color-bg)] hover:text-[var(--color-text)]"
            data-turbo-submits-with="<%= t('smart_search.feedback.sending') %>">
      <%= lucide_icon "thumbs-down", class: "w-3.5 h-3.5", "stroke-width": 2 %>
      <%= t("smart_search.feedback.bad") %>
    </button>
    <input type="text" name="comment" maxlength="1000"
           placeholder="<%= t('smart_search.feedback.comment_placeholder') %>"
           class="ml-auto h-8 flex-1 max-w-xs rounded-sm border-2 border-[var(--color-border)] bg-[var(--color-bg)] px-3 text-sm text-[var(--color-text)] placeholder-[var(--color-text-muted)] focus:border-[var(--color-accent)] focus:outline-none">
  <% end %>
</div>
