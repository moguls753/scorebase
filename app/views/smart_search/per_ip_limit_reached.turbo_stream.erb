<turbo-stream action="replace" target="results">
  <template>
    <div id="results" class="max-w-2xl mx-auto px-4 sm:px-6 py-12 text-center">
      <h2 class="text-xl font-[var(--font-family-display)] font-bold text-[var(--color-primary)] mb-3">
        <%= t("smart_search.per_ip_limit_reached.heading") %>
      </h2>
      <p class="text-sm text-[var(--color-text-secondary)] mb-4">
        <%= t("smart_search.per_ip_limit_reached.body_html") %>
      </p>
      <%= link_to t("smart_search.per_ip_limit_reached.regular_search_cta"), scores_path,
                  class: "text-[var(--color-accent)] hover:underline font-medium" %>
      <p class="mt-6 text-xs text-[var(--color-text-muted)] leading-relaxed">
        <%= t("smart_search.per_ip_limit_reached.pro_pitch_html",
              link: link_to(t("smart_search.per_ip_limit_reached.pro_pitch_link"), pro_landing_path(anchor: "waitlist"),
                            class: "text-[var(--color-accent)] hover:underline font-medium")).html_safe %>
      </p>
    </div>
  </template>
</turbo-stream>
<turbo-stream action="remove" target="refine-form"></turbo-stream>
