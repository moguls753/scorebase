<% content_for :title do %>Smart Search — Beta limit reached<% end %>
<% content_for :robots, "noindex,follow" %>

<div class="max-w-2xl mx-auto px-4 sm:px-6 py-16 text-center">
  <div class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-[var(--color-accent)]/10 mb-5">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
         stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"></circle>
      <polyline points="12 6 12 12 16 14"></polyline>
    </svg>
  </div>

  <h1 class="text-2xl font-[var(--font-family-display)] font-black text-[var(--color-primary)] mb-3">
    <%= t("smart_search.quota_exhausted.heading") %>
  </h1>

  <p class="text-base text-[var(--color-text-secondary)] mb-6 leading-relaxed">
    <%= t("smart_search.quota_exhausted.body_html") %>
  </p>

  <%= link_to t("smart_search.quota_exhausted.regular_search_cta"), scores_path,
              class: "inline-flex items-center gap-1.5 px-5 py-2.5 text-sm font-medium bg-[var(--color-accent)] text-white rounded-lg hover:bg-[var(--color-accent)]/90 transition-colors" %>

  <p class="mt-8 text-sm text-[var(--color-text-muted)] leading-relaxed">
    <%= t("smart_search.quota_exhausted.pro_pitch_html",
          link: link_to(t("smart_search.quota_exhausted.pro_pitch_link"), pro_landing_path(anchor: "waitlist"),
                        class: "text-[var(--color-accent)] hover:underline font-medium")).html_safe %>
  </p>
</div>
