<div class="overflow-x-auto">
  <table class="min-w-full text-sm">
    <thead>
      <tr class="border-b border-gray-200">
        <th class="text-left py-2 px-3 font-medium text-gray-500">Date</th>
        <th class="text-right py-2 px-3 font-medium text-gray-500">Visits</th>
        <th class="text-right py-2 px-3 font-medium text-gray-500">SMD Clicks</th>
        <th class="text-right py-2 px-3 font-medium text-gray-500">Scores</th>
      </tr>
    </thead>
    <tbody>
      <% @stats.each do |stat| %>
        <% clicks_data = stat.smd_clicks_by_score || {} %>
        <tr class="border-b border-gray-100 hover:bg-gray-50">
          <td class="py-2 px-3 text-gray-700"><%= stat.date.strftime("%b %d") %></td>
          <td class="py-2 px-3 text-right text-gray-900 tabular-nums"><%= number_with_delimiter(stat.visits) %></td>
          <td class="py-2 px-3 text-right text-gray-900 tabular-nums"><%= stat.total_smd_clicks %></td>
          <td class="py-2 px-3 text-right text-gray-500 tabular-nums"><%= clicks_data.keys.count %></td>
        </tr>
      <% end %>
      <% if @stats.empty? %>
        <tr>
          <td colspan="4" class="py-4 px-3 text-center text-gray-400">No data yet</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
