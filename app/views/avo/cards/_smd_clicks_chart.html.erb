<%
  # Get last 30 days of data
  stats = DailyStat.where(date: 30.days.ago..Date.current).order(:date)

  visits_data = stats.map { |s| [s.date, s.visits] }
  clicks_data = stats.map { |s| [s.date, s.smd_clicks] }

  # Calculate conversion rate for context
  total_visits = stats.sum(&:visits)
  total_clicks = stats.sum(&:smd_clicks)
  conversion_rate = total_visits.positive? ? ((total_clicks.to_f / total_visits) * 100).round(2) : 0
%>

<div class="p-4 w-full h-full flex flex-col">
  <div class="flex items-center gap-6 mb-4 text-sm">
    <div class="flex items-center gap-2">
      <span class="w-3 h-3 rounded-full" style="background: #c45a10;"></span>
      <span class="text-gray-600">Visits</span>
      <span class="font-semibold text-gray-900"><%= number_with_delimiter(total_visits) %></span>
    </div>
    <div class="flex items-center gap-2">
      <span class="w-3 h-3 rounded-full" style="background: #0d9488;"></span>
      <span class="text-gray-600">SMD Clicks</span>
      <span class="font-semibold text-gray-900"><%= number_with_delimiter(total_clicks) %></span>
    </div>
    <div class="flex items-center gap-2 ml-auto">
      <span class="text-gray-600">Click Rate</span>
      <span class="font-semibold" style="color: #0d9488;"><%= conversion_rate %>%</span>
    </div>
  </div>

  <div class="flex-1">
    <%= line_chart [
      { name: "Visits", data: visits_data },
      { name: "SMD Clicks", data: clicks_data }
    ],
    height: "260px",
    colors: ["#c45a10", "#0d9488"],
    library: {
      interaction: { intersect: false, mode: "index" },
      plugins: {
        legend: { display: false },
        tooltip: {
          backgroundColor: "#1f2937",
          titleFont: { weight: "600" },
          padding: 12,
          cornerRadius: 4
        }
      },
      scales: {
        y: {
          beginAtZero: true,
          grid: { color: "rgba(0,0,0,0.05)" }
        },
        x: {
          grid: { display: false }
        }
      },
      elements: {
        line: { tension: 0.3, borderWidth: 2 },
        point: { radius: 0, hoverRadius: 5 }
      }
    } %>
  </div>
</div>
