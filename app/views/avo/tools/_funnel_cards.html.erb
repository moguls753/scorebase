<div class="bg-green-50 rounded-lg p-4">
  <div class="text-2xl font-bold text-green-600"><%= summary[:days].positive? ? number_with_delimiter(summary[:human_visits]) : "—" %></div>
  <div class="text-sm text-gray-500">Human Visits<%= " · #{summary[:days]}d measured" if summary[:days].positive? %></div>
</div>

<% Score::COMMERCIAL_PARTNERS.each_value do |partner| %>
  <% funnel = summary[:partners][partner.source] %>
  <h3 class="mt-6 mb-2 text-sm font-semibold text-gray-600"><%= partner.name %></h3>
  <div class="grid grid-cols-1 xl:grid-cols-3 gap-4">
    <div class="bg-indigo-50 rounded-lg p-4">
      <div class="text-2xl font-bold text-indigo-600"><%= funnel[:days].positive? ? number_with_delimiter(funnel[:page_visits]) : "—" %></div>
      <div class="text-sm text-gray-500">Reached a Paid Score<%= " · #{funnel[:reach]}% of them" if funnel[:reach] %></div>
    </div>
    <div class="bg-teal-50 rounded-lg p-4">
      <div class="text-2xl font-bold text-teal-600"><%= funnel[:days].positive? ? number_with_delimiter(funnel[:clicks]) : "—" %></div>
      <div class="text-sm text-gray-500">Buy Clicks<%= " · from #{number_with_delimiter(funnel[:converting])} visits" if funnel[:days].positive? %></div>
    </div>
    <div class="bg-violet-50 rounded-lg p-4">
      <div class="text-2xl font-bold text-violet-600"><%= funnel[:conversion_rate] ? "#{funnel[:conversion_rate]}%" : "—" %></div>
      <div class="text-sm text-gray-500">Buy Rate<%= " · #{number_with_delimiter(funnel[:converting])} of #{number_with_delimiter(funnel[:page_visits])}" if funnel[:conversion_rate] %></div>
    </div>
  </div>
<% end %>

<p class="mt-6 text-xs text-gray-500 leading-relaxed">
  The funnel reads left to right, per partner: real people arrive, some reach a paid score page, some of those click through to buy.
  <strong>Buy Rate</strong> divides converting visits by the ones that reached a paid page — not by all traffic — so it measures the step you can
  actually influence. <strong>Human Visits</strong> uses the same definition and window as the Analytics dashboard, so the two pages are comparable.
  Buy Clicks counts every click (two editions, or two clicks, each count); converting visits counts distinct people.
</p>
