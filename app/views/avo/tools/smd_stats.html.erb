<div class="flex flex-col gap-6">
  <%# Summary Stats %>
  <%= render Avo::PanelComponent.new(name: '30-Day Summary') do |c| %>
    <% c.with_body do %>
      <div class="px-6 py-4">
        <div class="grid grid-cols-2 gap-4">
          <div class="bg-orange-50 rounded-lg p-4">
            <div class="text-2xl font-bold text-orange-600"><%= number_with_delimiter(@visits_30d) %></div>
            <div class="text-sm text-gray-500">Total Visits</div>
          </div>
          <div class="bg-teal-50 rounded-lg p-4">
            <div class="text-2xl font-bold text-teal-600"><%= number_with_delimiter(@clicks_30d) %></div>
            <div class="text-sm text-gray-500">SMD Clicks</div>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>

  <%# Chart %>
  <%= render Avo::PanelComponent.new(name: 'Visits & Clicks (14 Days)') do |c| %>
    <% c.with_body do %>
      <div class="px-6 py-4">
        <%= line_chart [
          { name: "Visits", data: @stats.map { |s| [s.date, s.visits] } },
          { name: "SMD Clicks", data: @stats.map { |s| [s.date, s.total_smd_clicks] } }
        ],
        colors: ["#ea580c", "#0d9488"],
        library: {
          scales: { y: { beginAtZero: true } },
          plugins: { legend: { position: "bottom" } },
          elements: { line: { tension: 0.3 } }
        } %>
      </div>
    <% end %>
  <% end %>

  <%# Daily Breakdown %>
  <%= render Avo::PanelComponent.new(name: 'Daily Stats (Last 14 Days)') do |c| %>
    <% c.with_body do %>
      <div class="px-6 py-4">
        <% if @stats.any? %>
          <table class="min-w-full text-sm">
            <thead>
              <tr class="border-b border-gray-200">
                <th class="py-2 text-left text-gray-600">Date</th>
                <th class="py-2 text-right text-gray-600">Visits</th>
                <th class="py-2 text-right text-gray-600">SMD Clicks</th>
                <th class="py-2 text-right text-gray-600">Scores Clicked</th>
              </tr>
            </thead>
            <tbody>
              <% @stats.each do |stat| %>
                <tr class="border-b border-gray-100 hover:bg-gray-50">
                  <td class="py-2 text-gray-700"><%= stat.date.strftime("%b %d, %Y") %></td>
                  <td class="py-2 text-right font-mono"><%= number_with_delimiter(stat.visits) %></td>
                  <td class="py-2 text-right font-mono text-teal-600"><%= stat.total_smd_clicks %></td>
                  <td class="py-2 text-right font-mono text-gray-500"><%= (stat.smd_clicks_by_score || {}).keys.count %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="text-gray-500 italic">No stats recorded yet.</p>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
