<div class="flex flex-col gap-6">
  <%= render Avo::PanelComponent.new(name: "#{@range_days}-Day Summary") do |c| %>
    <% c.with_body do %>
      <div class="px-6 py-4">
        <%= render "funnel_cards", summary: @summary %>
      </div>
    <% end %>
  <% end %>

  <%= render Avo::PanelComponent.new(name: "Daily Stats (Last #{@range_days} Days)") do |c| %>
    <% c.with_body do %>
      <div class="px-6 py-4 max-h-96 overflow-y-auto">
        <% if @stats.any? %>
          <table class="min-w-full text-sm">
            <thead>
              <tr class="border-b border-gray-200">
                <th class="py-2 text-left text-gray-600">Date</th>
                <th class="py-2 text-right text-gray-600">Human Visits</th>
                <th class="py-2 text-right text-gray-600">Buy Clicks</th>
              </tr>
            </thead>
            <tbody>
              <% @stats.each do |stat| %>
                <tr class="border-b border-gray-100 hover:bg-gray-50">
                  <td class="py-2 text-gray-700"><%= stat.date.strftime("%b %d, %Y") %></td>
                  <td class="py-2 text-right font-mono font-semibold text-green-600"><%= stat.human_visits ? number_with_delimiter(stat.human_visits) : "—" %></td>
                  <td class="py-2 text-right font-mono text-teal-600"><%= stat.human_visits ? Score::COMMERCIAL_SOURCES.sum { |source| stat.total_clicks(source) } : "—" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="text-gray-500 italic">No stats recorded yet.</p>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <%= render Avo::PanelComponent.new(name: "Top Clicked Scores (Last #{@range_days} Days)") do |c| %>
    <% c.with_body do %>
      <div class="px-6 py-4">
        <% if @top_clicked_scores.any? %>
          <table class="min-w-full text-sm">
            <thead>
              <tr class="border-b border-gray-200">
                <th class="py-2 text-left text-gray-600">Score</th>
                <th class="py-2 text-left text-gray-600">Composer</th>
                <th class="py-2 text-right text-gray-600">Clicks</th>
              </tr>
            </thead>
            <tbody>
              <% @top_clicked_scores.each do |score, clicks| %>
                <tr class="border-b border-gray-100 hover:bg-gray-50">
                  <td class="py-2">
                    <%= link_to score.title&.truncate(50) || "Untitled", main_app.score_path(id: score.id), target: "_blank", class: "text-teal-600 hover:underline" %>
                  </td>
                  <td class="py-2 text-gray-500"><%= score.composer&.truncate(30) %></td>
                  <td class="py-2 text-right font-mono text-teal-600 font-bold"><%= clicks %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="text-gray-500 italic">No clicks recorded yet.</p>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
