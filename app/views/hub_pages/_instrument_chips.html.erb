<%# Instrument Chips - Cross-linking for single-dimension hub pages
    Displays quick-filter chips linking to combined pages (e.g., /periods/classical/piano)

    Local variables:
    - type: Symbol - :period, :genre, or :composer
    - slug: String - The slug of the current dimension (e.g., "classical")
    - instruments: Array<Hash> - Top instruments with :name, :slug, :count
%>
<% if instruments.present? %>
  <div class="instrument-chips">
    <div class="instrument-chips__header">
      <span class="instrument-chips__label"><%= t('hub.browse_by_instrument') %></span>
      <span class="instrument-chips__line"></span>
    </div>
    <div class="instrument-chips__list">
      <% instruments.each_with_index do |instrument, index| %>
        <%= link_to instrument_chip_path(type, slug, instrument[:slug]), class: "instrument-chip", style: "animation-delay: #{index * 40}ms" do %>
          <span class="instrument-chip__icon"><%= instrument_svg_icon(instrument[:name], size: 16) %></span>
          <span class="instrument-chip__name"><%= translate_hub_name(:instruments, instrument) %></span>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
