<%# Shared filter fields for instrument+difficulty page (mobile bottom sheet)
    Params:
    - f: form builder
    - mobile: boolean (optional) - whether this is mobile layout
    - filter_options: hash with :composers, :genres, :periods arrays
%>
<% mobile ||= false %>

<div class="<%= mobile ? 'grid grid-cols-2 gap-4' : 'space-y-4' %>">
  <!-- Filter: Composer -->
  <% if filter_options[:composers].present? %>
    <div>
      <label for="mobile-composer" class="block text-xs font-bold text-[var(--color-text-muted)] mb-2 uppercase tracking-wide font-[var(--font-family-display)]">
        <%= t('sort.composer') %>
      </label>
      <%= f.select :composer,
          options_for_select(
            [[t('filters.any'), '']] + filter_options[:composers].map { |c| [c[:name], c[:slug]] },
            params[:composer]
          ),
          {},
          {
            id: "mobile-composer",
            class: "mm-input w-full text-sm",
            data: { action: mobile ? "change->filter-modal#closeAndSubmit" : "change->url-sync#submit" }
          }
      %>
    </div>
  <% end %>

  <!-- Filter: Genre -->
  <% if filter_options[:genres].present? %>
    <div>
      <label for="mobile-genre" class="block text-xs font-bold text-[var(--color-text-muted)] mb-2 uppercase tracking-wide font-[var(--font-family-display)]">
        <%= t('filters.genre') %>
      </label>
      <%= f.select :genre,
          options_for_select(
            [[t('filters.any'), '']] + filter_options[:genres].map { |g| [translate_hub_name(:genres, g), g[:slug]] },
            params[:genre]
          ),
          {},
          {
            id: "mobile-genre",
            class: "mm-input w-full text-sm",
            data: { action: mobile ? "change->filter-modal#closeAndSubmit" : "change->url-sync#submit" }
          }
      %>
    </div>
  <% end %>

  <!-- Filter: Period -->
  <% if filter_options[:periods].present? %>
    <div>
      <label for="mobile-period" class="block text-xs font-bold text-[var(--color-text-muted)] mb-2 uppercase tracking-wide font-[var(--font-family-display)]">
        <%= t('hub.filter_period') %>
      </label>
      <%= f.select :period,
          options_for_select(
            [[t('filters.any'), '']] + filter_options[:periods].map { |p| [p[:name], p[:slug]] },
            params[:period]
          ),
          {},
          {
            id: "mobile-period",
            class: "mm-input w-full text-sm",
            data: { action: mobile ? "change->filter-modal#closeAndSubmit" : "change->url-sync#submit" }
          }
      %>
    </div>
  <% end %>
</div>
