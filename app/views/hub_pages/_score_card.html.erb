<%= link_to score_path(score), class: "mm-card overflow-hidden group flex flex-col", data: { turbo_frame: "_top", turbo_prefetch: false } do %>
  <%= render "scores/thumbnail", score: score %>

  <!-- Card Content - Flex column to anchor badges at bottom -->
  <div class="p-4 sm:p-5 flex flex-col flex-1">
    <h4 class="text-sm sm:text-base font-[var(--font-family-display)] text-[var(--color-primary)] mb-1.5 leading-tight font-bold line-clamp-2 group-hover:text-[var(--color-accent)] transition-colors">
      <%= score.display_title %>
    </h4>
    <p class="text-xs sm:text-sm text-[var(--color-text-muted)] line-clamp-1 font-medium">
      <%= score.composer.presence || t('search.unknown_composer') %>
    </p>

    <% if score.primary_instrument.present? || score.has_grouped_parts? %>
      <div class="flex flex-wrap gap-1.5 mt-auto pt-3">
        <% if score.primary_instrument.present? %>
          <span class="mm-badge mm-badge--instrument text-[10px] sm:text-[11px]">
            <%= score.primary_instrument %>
          </span>
        <% end %>

        <% if score.has_grouped_parts? %>
          <span class="mm-badge mm-badge--parts text-[10px] sm:text-[11px]">
            <%= score.group_parts_count %> <%= t('score.parts_label') %>
          </span>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
