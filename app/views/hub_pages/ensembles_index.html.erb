<% content_for :title, @page_title %>
<% content_for :meta_description, @page_description %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-preview">
<% end %>

<!-- Hero Section -->
<section class="hub-hero py-10 sm:py-14 lg:py-20 border-b-2 border-[var(--color-border)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="max-w-3xl">
      <nav class="flex items-center gap-2 text-xs font-medium text-[var(--color-text-muted)] mb-4">
        <%= link_to root_path, class: "hover:text-[var(--color-accent)] transition-colors" do %>
          ScoreBase
        <% end %>
        <span class="text-[var(--color-border-subtle)]">/</span>
        <span class="text-[var(--color-accent)]"><%= t('hub.ensembles') %></span>
      </nav>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-[var(--font-family-display)] mb-3 leading-tight font-black uppercase tracking-tight hero-title">
        <%= t('hub.ensembles') %>
      </h1>
      <p class="text-base sm:text-lg font-medium hero-subtitle">
        <%= t('hub.ensembles_description', count: @ensembles.size) %>
      </p>
    </div>
  </div>
</section>

<!-- Grouped ensemble cards — compact style shared with the genre/instrument index -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-10">
  <% if @ensembles.any? %>
    <% global_index = 0 %>
    <% [[:instrumental, t('hub.ensembles_instrumental')], [:choral, t('hub.ensembles_choral')]].each do |group_key, group_label| %>
      <% items = @ensemble_groups[group_key] %>
      <% next if items.blank? %>
      <section class="mb-8 sm:mb-10 last:mb-0">
        <div class="flex items-baseline gap-3 mb-4">
          <h2 class="text-xs sm:text-sm font-[var(--font-family-display)] font-bold uppercase tracking-wide text-[var(--color-text-muted)]">
            <%= group_label %>
          </h2>
          <span class="text-xs text-[var(--color-border-subtle)] font-semibold"><%= items.size %></span>
          <div class="flex-1 border-t border-[var(--color-border)]"></div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 sm:gap-4">
          <% items.each do |ensemble| %>
            <%= render "hub_pages/hub_card_simple",
                item: ensemble,
                path: ensemble_path(slug: ensemble[:slug]),
                search_attribute: "ensembleName",
                index: global_index %>
            <% global_index += 1 %>
          <% end %>
        </div>
      </section>
    <% end %>
  <% else %>
    <div class="mm-card p-8 sm:p-12 text-center">
      <p class="text-[var(--color-text-muted)] font-medium"><%= t('hub.no_scores_found') %></p>
    </div>
  <% end %>
</div>
