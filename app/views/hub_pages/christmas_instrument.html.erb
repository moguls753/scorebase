<% content_for :title, @page_title %>
<% content_for :meta_description, @page_description %>

<!-- Hero Section -->
<section class="hub-hero py-8 sm:py-12 lg:py-16 border-b-2 border-[var(--color-border)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <nav class="flex items-center gap-2 text-xs font-medium text-[var(--color-text-muted)] mb-4">
      <%= link_to root_path, class: "hover:text-[var(--color-accent)] transition-colors" do %>ScoreBase<% end %>
      <span class="text-[var(--color-border-subtle)]">/</span>
      <%= link_to christmas_path, class: "hover:text-[var(--color-accent)] transition-colors" do %><%= t('hub.christmas') %><% end %>
      <span class="text-[var(--color-border-subtle)]">/</span>
      <span class="text-[var(--color-accent)]"><%= @instrument_display_name %></span>
    </nav>

    <div class="flex flex-col gap-5">
      <div>
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-[var(--font-family-display)] mb-3 leading-tight font-black uppercase tracking-tight hero-title">
          <%= t('hub.christmas_instrument_heading', instrument: @instrument_display_name) %>
        </h1>
        <p class="text-sm sm:text-base font-medium hero-subtitle">
          <span class="text-[var(--color-accent)] font-bold"><%= number_with_delimiter(@total_count) %></span>
          <%= t('hub.free_instrument_christmas_scores', instrument: @instrument_display_name.downcase) %>
        </p>
      </div>

      <!-- Search Bar -->
      <%= form_with url: christmas_instrument_path(instrument_slug: @instrument_slug), method: :get, data: { turbo_frame: "scores" }, class: "max-w-2xl" do |f| %>
        <div class="flex gap-2 sm:gap-3">
          <div class="flex-1 relative">
            <%= f.text_field :q,
              placeholder: t('hub.search_christmas_instrument', instrument: @instrument_display_name.downcase),
              value: params[:q],
              class: "w-full mm-input text-sm sm:text-base",
              style: "padding-left: 44px;",
              autocomplete: "off"
            %>
            <div class="absolute left-3.5 top-1/2 -translate-y-1/2 text-[var(--color-text-muted)] pointer-events-none">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.3-4.3"></path>
              </svg>
            </div>
          </div>
          <%= f.submit t('search.button'), class: "mm-button mm-button-primary cursor-pointer text-xs px-5 sm:px-6" %>
        </div>
      <% end %>
    </div>
  </div>
</section>

<!-- Scores Grid -->
<turbo-frame id="scores" data-turbo-action="advance">
<div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-10">
  <!-- Results count -->
  <p class="text-xs text-[var(--color-text-muted)] font-semibold uppercase tracking-wide mb-5">
    <% if @filtered_count != @total_count %>
      <span class="text-[var(--color-accent)] font-bold"><%= number_with_delimiter(@filtered_count) %></span>
      <span class="text-[var(--color-border)]">/</span>
      <%= number_with_delimiter(@total_count) %> <%= t('search.results_count') %>
    <% else %>
      <span class="text-[var(--color-accent)] font-bold"><%= number_with_delimiter(@total_count) %></span> <%= t('search.results_count') %>
    <% end %>
  </p>

  <% if @scores.any? %>
    <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 sm:gap-5 lg:gap-6">
      <% @scores.each do |score| %>
        <%= render 'score_card', score: score, instrument: @instrument_name, instrument_label: @instrument_display_name %>
      <% end %>
    </div>
    <%= render 'shared/pagination', scores: @scores, turbo_frame: 'scores' %>
  <% else %>
    <div class="mm-card p-8 sm:p-12 text-center">
      <div class="text-6xl mb-4 text-[var(--color-border-subtle)]">🎄</div>
      <p class="text-[var(--color-text-muted)] font-medium"><%= t('hub.no_scores_found') %></p>
      <% if params[:q].present? %>
        <p class="text-xs text-[var(--color-text-subtle)] mb-4"><%= t('hub.no_scores_hint') %></p>
        <%= link_to t('search.clear'), christmas_instrument_path(instrument_slug: @instrument_slug), data: { turbo_frame: "scores" }, class: "mm-button mm-button-secondary text-xs" %>
      <% end %>
    </div>
  <% end %>
</div>
</turbo-frame>
