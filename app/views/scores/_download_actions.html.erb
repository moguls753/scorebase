<%#
  Download/Purchase action buttons for a score

  Usage:
    render "scores/download_actions", score: @score, variant: :mobile

  Variants:
    :mobile  - Compact buttons for quick actions above fold
    :sidebar - Full buttons with tooltips for desktop sidebar

  Handles both free scores (PDF/MIDI/MXL downloads) and commercial partner scores (buy button).
%>
<% score ||= @score %>
<% variant ||= :sidebar %>
<% return unless score.has_downloads? || score.purchasable? %>
<% buy_path = score.purchasable? ? buy_redirect_path(score) : nil %>

<%# IMSLP/CPDL host the file themselves — label the buttons so. %>
<% external = score.external? %>
<% source_name = score.source.to_s.upcase %>
<% pdf_label  = external ? t("score.download_on_source", file_format: "PDF", source: source_name) : t("score.download_pdf") %>
<% midi_label = external ? t("score.download_on_source", file_format: "MIDI", source: source_name) : t("score.download_midi") %>
<% mxl_label  = external ? t("score.download_on_source", file_format: "MXL", source: source_name) : t("score.download_mxl") %>

<% if variant == :mobile %>
  <%# Mobile: Compact single-row layout %>
  <div class="dl-row">
    <% if buy_path %>
      <%# Partner: Single buy button (teal to distinguish from free downloads) %>
      <%# JS-based redirect: href="#" so bots can't follow, Stimulus handles the click %>
      <%= link_to "#",
          class: "dl-btn dl-btn--primary dl-btn--buy",
          aria: { label: buy_cta_label(score) },
          data: {
            controller: "buy-redirect",
            buy_redirect_url_value: buy_path,
            buy_redirect_score_id_value: score.id,
            buy_redirect_event_value: Ahoy::Event::CLICK_EVENTS[score.source],
            action: "click->buy-redirect#go"
          } do %>
        <span class="dl-label"><%= buy_cta_label(score) %></span>
      <% end %>
    <% else %>
      <%# Free: Download buttons %>
      <% if score.has_pdf? %>
        <%= link_to file_score_path(score, 'pdf', download: true),
            class: "dl-btn dl-btn--primary",
            aria: { label: pdf_label } do %>
          <svg class="dl-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="square" stroke-width="2" d="M8 2v9m0 0l-3-3m3 3l3-3M3 13h10"/>
          </svg>
          <span class="dl-label">PDF<%= " ↗" if external %></span>
        <% end %>
      <% end %>
      <% if score.has_midi? %>
        <%= link_to file_score_path(score, 'mid', download: true),
            class: "dl-btn dl-btn--secondary",
            aria: { label: midi_label } do %>
          <svg class="dl-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="square" stroke-width="2" d="M8 2v9m0 0l-3-3m3 3l3-3M3 13h10"/>
          </svg>
          <span class="dl-label">MIDI<%= " ↗" if external %></span>
        <% end %>
      <% end %>
      <% if score.has_mxl? %>
        <%= link_to file_score_path(score, 'mxl', download: true),
            class: "dl-btn dl-btn--secondary",
            aria: { label: mxl_label } do %>
          <svg class="dl-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="square" stroke-width="2" d="M8 2v9m0 0l-3-3m3 3l3-3M3 13h10"/>
          </svg>
          <span class="dl-label">MXL<%= " ↗" if external %></span>
        <% end %>
      <% end %>
    <% end %>
  </div>

<% else %>
  <%# Sidebar: Full labels, stacked vertically %>
  <div class="dl-stack">
    <% if buy_path %>
      <%# Partner: Buy button with helper text (teal to distinguish from free downloads) %>
      <%# JS-based redirect: href="#" so bots can't follow, Stimulus handles the click %>
      <%= link_to "#",
          class: "dl-btn dl-btn--primary dl-btn--buy dl-btn--full",
          aria: { label: buy_cta_label(score) },
          data: {
            controller: "buy-redirect",
            buy_redirect_url_value: buy_path,
            buy_redirect_score_id_value: score.id,
            buy_redirect_event_value: Ahoy::Event::CLICK_EVENTS[score.source],
            action: "click->buy-redirect#go"
          } do %>
        <span class="dl-label"><%= buy_cta_label(score) %></span>
      <% end %>
      <% if (minimum = minimum_order(score)) %>
        <p class="dl-hint dl-hint--warn"><%= t("score.min_quantity", count: minimum[:quantity], total: minimum[:total]) %></p>
      <% end %>
      <% if (tiers = bulk_prices(score)).any? %>
        <table class="dl-bulk">
          <caption><%= t("score.bulk_prices") %></caption>
          <tbody>
            <% tiers.each do |tier| %>
              <tr>
                <th scope="row"><%= t("score.bulk_price_row", amount: tier[:amount]) %></th>
                <td><%= tier[:price] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
      <p class="dl-hint"><%= t("score.#{score.source}_hint") %><% if score.price_currency == "EUR" %> · <%= t("score.price_incl_vat") %><% end %></p>
    <% else %>
      <%# Free: Download buttons %>
      <% if score.has_pdf? %>
        <%= link_to file_score_path(score, 'pdf', download: true),
            class: "dl-btn dl-btn--primary dl-btn--full",
            aria: { label: pdf_label } do %>
          <svg class="dl-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="square" stroke-width="2" d="M8 2v9m0 0l-3-3m3 3l3-3M3 13h10"/>
          </svg>
          <span class="dl-label"><%= pdf_label %><%= " ↗" if external %></span>
        <% end %>
      <% end %>

      <% if score.has_midi? %>
        <%= link_to file_score_path(score, 'mid', download: true),
            class: "dl-btn dl-btn--secondary dl-btn--full",
            aria: { label: midi_label } do %>
          <svg class="dl-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="square" stroke-width="2" d="M8 2v9m0 0l-3-3m3 3l3-3M3 13h10"/>
          </svg>
          <span class="dl-label"><%= midi_label %><%= " ↗" if external %></span>
        <% end %>
      <% end %>

      <% if score.has_mxl? %>
        <div class="mm-tooltip-wrap">
          <%= link_to file_score_path(score, 'mxl', download: true),
              class: "dl-btn dl-btn--secondary dl-btn--full",
              aria: { label: mxl_label } do %>
            <svg class="dl-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="square" stroke-width="2" d="M8 2v9m0 0l-3-3m3 3l3-3M3 13h10"/>
            </svg>
            <span class="dl-label"><%= mxl_label %><%= " ↗" if external %></span>
          <% end %>
          <span class="mm-tooltip"><%= t('score.mxl_hint') %></span>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
