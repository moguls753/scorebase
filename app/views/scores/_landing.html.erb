<% content_for :json_ld do %>
  <script type="application/ld+json">
  <%= {
    "@context"       => "https://schema.org",
    "@type"          => "WebSite",
    "name"           => "ScoreBase",
    "alternateName"  => "ScoreBase Sheet Music Search",
    "url"            => request.base_url,
    "description"    => t('meta.description'),
    "inLanguage"     => ["en", "de"],
    "publisher"      => {
      "@type" => "Organization",
      "name"  => "ScoreBase",
      "url"   => request.base_url,
      "logo"  => {
        "@type" => "ImageObject",
        "url"   => "#{request.base_url}/icon.png"
      },
      "sameAs" => [
        "https://github.com/moguls753/scorebase"
      ]
    }
  }.to_json.html_safe %>
  </script>
<% end %>

<!-- Hero Section with Search -->
<section class="hero-section py-8 sm:py-12 lg:py-16" data-view="landing">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="max-w-3xl mx-auto text-center">
      <h2 id="hero-heading" tabindex="-1" class="text-3xl sm:text-4xl lg:text-5xl font-[var(--font-family-display)] mb-2 sm:mb-3 leading-tight font-black uppercase tracking-tight hero-title">
        <%= t('search.hero_title_line1') %>
      </h2>
      <p class="hidden sm:block text-base sm:text-lg mb-2 sm:mb-3 font-medium hero-subtitle">
        <%= t('search.hero_title_line2') %>
      </p>
      <p class="text-sm sm:text-base mb-6 sm:mb-10 font-medium hero-subtitle opacity-75">
        <%= t('search.scores_ready', count: number_with_delimiter(@total_count)) %>
      </p>

      <!-- Search Bar -->
      <%= form_with url: scores_path, method: :get,
            html: { role: "search", class: "flex flex-col sm:flex-row items-stretch gap-2 sm:gap-3" } do |f| %>
        <div class="search-hero flex-1">
          <svg class="search-hero-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <%= f.search_field :q,
            value: params[:q],
            placeholder: t('search.placeholder'),
            aria: { label: t('search.placeholder') },
            enterkeyhint: "search",
            class: "w-full mm-input search-vt",
            data: { controller: "autofocus" }
          %>
        </div>

        <!-- Mobile: full-width Search Button (explore tiles render inline below) -->
        <%= f.submit t('search.button'), class: "sm:hidden mm-button mm-button-primary cursor-pointer text-xs w-full" %>

        <!-- Desktop: Full Width Search Button -->
        <%= f.submit t('search.button'), class: "hidden sm:block mm-button mm-button-primary cursor-pointer px-6 text-xs w-full sm:w-auto" %>
      <% end %>

      <!-- Explore tiles — inline on every viewport -->
      <div>
        <div class="browse-divider">
          <span class="browse-divider-text"><%= t('search.or_explore') %></span>
        </div>
        <nav class="browse-links" aria-label="Browse categories">
        <%= link_to composers_path, class: "browse-link" do %>
          <%= navigation_svg_icon(:composers, size: 20, html_class: "browse-link-icon") %>
          <%= t('search.browse_composers') %>
        <% end %>
        <%= link_to artists_path, class: "browse-link" do %>
          <%= navigation_svg_icon(:artists, size: 20, html_class: "browse-link-icon") %>
          <%= t('search.browse_artists') %>
        <% end %>
        <%= link_to instruments_path, class: "browse-link" do %>
          <%= navigation_svg_icon(:instruments, size: 20, html_class: "browse-link-icon") %>
          <%= t('search.browse_instruments') %>
        <% end %>
        <%= link_to genres_path, class: "browse-link" do %>
          <%= navigation_svg_icon(:genres, size: 20, html_class: "browse-link-icon") %>
          <%= t('search.browse_genres') %>
        <% end %>
        <%= link_to periods_path, class: "browse-link" do %>
          <%= navigation_svg_icon(:periods, size: 20, html_class: "browse-link-icon") %>
          <%= t('search.browse_periods') %>
        <% end %>
        <%= link_to ensembles_path, class: "browse-link" do %>
          <%= navigation_svg_icon(:ensembles, size: 20, html_class: "browse-link-icon") %>
          <%= t('search.browse_ensembles') %>
        <% end %>
        </nav>
      </div>

      <!-- Smart Search Teaser — entry to /smart-search from any viewport -->
      <%= render "shared/smart_search_teaser", wrapper_class: "mt-2" %>
    </div>
  </div>
</section>
