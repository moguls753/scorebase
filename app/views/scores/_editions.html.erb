<%# One partner's buy boxes for a free score. Every row splits two destinations:
    thumbnail/title go to the edition's own ScoreBase page, the price is an
    affiliate-tagged buy via /go/ with client-side-only Ahoy tracking (bots hitting
    /go/ server-side never fire the JS event).

    Locals: editions: (non-empty), heading:, trust: %>

<% hero = editions.first %>
<% rest = editions[1..] %>

<div class="mm-card pro-editions-card p-3 sm:p-4">
  <h3 class="grouped-parts__header">
    <span class="grouped-parts__icon">♪</span>
    <%= heading %>
  </h3>
  <p class="pro-editions__trust"><%= trust %></p>

  <div class="pro-editions__hero">
    <%= link_to score_path(hero), class: "pro-editions__hero-media", data: { turbo_prefetch: false } do %>
      <% if hero.has_thumbnail? %>
        <%= image_tag hero.thumbnail(width: 300), alt: hero.title, loading: "lazy", decoding: "async",
              class: "pro-editions__hero-thumb" %>
      <% else %>
        <span class="pro-editions__hero-thumb pro-editions__thumb--empty">♪</span>
      <% end %>
    <% end %>
    <div class="pro-editions__hero-body">
      <span class="pro-editions__hero-eyebrow"><%= t('score.recommended_edition') %></span>
      <%= link_to hero.title, score_path(hero),
            class: "pro-editions__hero-title", data: { turbo_prefetch: false } %>
      <span class="pro-editions__meta">
        <span class="pro-editions__category"><%= edition_subtitle(hero) %></span>
        <% if (grade = localized_pedagogical_grade(hero)) %>
          <span class="pro-editions__grade"><%= grade %></span>
        <% end %>
      </span>
    </div>
    <%= render "scores/buy_link", edition: hero, css_class: "pro-editions__buy", label: buy_cta_label(hero) %>
  </div>

  <% if rest.any? %>
    <div class="pro-editions__list">
      <% rest.each do |edition| %>
        <div class="pro-editions__item">
          <%= link_to score_path(edition),
                class: "pro-editions__item-link",
                data: { turbo_prefetch: false } do %>
            <% if edition.has_thumbnail? %>
              <%= image_tag edition.thumbnail(width: 200), alt: edition.title, loading: "lazy", decoding: "async",
                    class: "pro-editions__thumb" %>
            <% else %>
              <span class="pro-editions__thumb pro-editions__thumb--empty">♪</span>
            <% end %>
            <span class="min-w-0 flex-1">
              <span class="pro-editions__title"><%= edition.title %></span>
              <span class="pro-editions__meta">
                <span class="pro-editions__category"><%= edition_subtitle(edition) %></span>
                <% if (grade = localized_pedagogical_grade(edition)) %>
                  <span class="pro-editions__grade"><%= grade %></span>
                <% end %>
              </span>
            </span>
          <% end %>
          <%= render "scores/buy_link", edition: edition, css_class: "pro-editions__item-price",
                label: format_score_price(edition).presence || buy_cta_label(edition),
                unavailable: format_score_price(edition) %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
