<%# Filter Fields - Label-free, self-describing dropdowns
    37signals-inspired: calm, obvious, breathing room
%>
<% mobile ||= false %>
<% is_vocal = params[:instrument]&.match?(/voice|choir/i) %>
<% submit_action = mobile ? "change->filter-modal#closeAndSubmit" : "change->url-sync#submit" %>

<div class="filter-stack" data-controller="instrument-context">

  <%# Instrument - what do you play? %>
  <%= f.select :instrument,
      options_for_select([
        [t('filters.all_instruments'), ''],
        [t('instruments.voice_choir'), 'voice'],
        [t('instruments.piano'), 'piano'],
        [t('instruments.organ'), 'organ'],
        [t('instruments.violin'), 'violin'],
        [t('instruments.cello'), 'cello'],
        [t('instruments.flute'), 'flute'],
        [t('instruments.guitar'), 'guitar']
      ], params[:instrument]),
      {},
      {
        class: "filter-select",
        data: {
          action: "change->instrument-context#update #{submit_action}",
          instrument_context_target: "select"
        }
      }
  %>

  <%# Difficulty - how hard? %>
  <%= f.select :difficulty,
      options_for_select([
        [t('filters.all_levels'), ''],
        [t('difficulty.beginner'), 'beginner'],
        [t('difficulty.elementary'), 'elementary'],
        [t('difficulty.intermediate'), 'intermediate'],
        [t('difficulty.advanced'), 'advanced'],
        [t('difficulty.expert'), 'expert']
      ], params[:difficulty]),
      {},
      { class: "filter-select", data: { action: submit_action } }
  %>

  <%# Period - when was it written? %>
  <%= f.select :period,
      options_for_select([
        [t('filters.all_periods'), ''],
        [t('periods.medieval'), 'Medieval'],
        [t('periods.renaissance'), 'Renaissance'],
        [t('periods.baroque'), 'Baroque'],
        [t('periods.classical'), 'Classical'],
        [t('periods.romantic'), 'Romantic'],
        [t('periods.modern'), 'Modern']
      ], params[:period]),
      {},
      { class: "filter-select", data: { action: submit_action } }
  %>

  <%# Genre - what style? %>
  <%= f.select :genre,
      options_for_select([
        [t('filters.all_genres'), ''],
        [t('genres.sacred'), 'sacred'],
        [t('genres.motet'), 'motet'],
        [t('genres.madrigal'), 'madrigal'],
        [t('genres.art_song'), 'art song'],
        [t('genres.hymn'), 'hymn'],
        [t('genres.folk'), 'folk'],
        [t('genres.sonata'), 'sonata'],
        [t('genres.classical'), 'classical']
      ], params[:genre]),
      {},
      { class: "filter-select", data: { action: submit_action } }
  %>

  <%# Parts - how many performers? %>
  <%= f.select :voicing,
      options_for_select([
        [t('filters.any_size'), ''],
        [t('parts.solo'), 'solo'],
        [t('parts.duet'), 'duet'],
        [t('parts.trio'), 'trio'],
        [t('parts.quartet'), 'quartet'],
        [t('parts.ensemble'), 'ensemble']
      ], params[:voicing]),
      {},
      { class: "filter-select", data: { action: submit_action } }
  %>

  <%# Length - how long? (practical refinement) %>
  <%= f.select :length,
      options_for_select([
        [t('filters.any_length'), ''],
        [t('length.short'), 'short'],
        [t('length.medium'), 'medium'],
        [t('length.long'), 'long']
      ], params[:length]),
      {},
      { class: "filter-select", data: { action: submit_action } }
  %>

  <%# Pricing - free or commercial? %>
  <%= f.select :pricing,
      options_for_select([
        [t('filters.any_pricing'), ''],
        [t('pricing.free'), 'free'],
        [t('pricing.commercial'), 'commercial']
      ], params[:pricing]),
      {},
      { class: "filter-select", data: { action: submit_action } }
  %>

  <%# Vocal-specific filters - appear when Voice/Choir selected %>
  <div class="filter-vocal-section <%= 'is-visible' if is_vocal %>"
       data-instrument-context-target="vocalFilters"
       <% unless is_vocal %>hidden<% end %>>

    <%# Voice Type %>
    <%= f.select :voice_type,
        options_for_select([
          [t('filters.all_voice_types'), ''],
          [t('voice_type.mixed'), 'mixed'],
          [t('voice_type.treble'), 'treble'],
          [t('voice_type.mens'), 'mens'],
          [t('voice_type.unison'), 'unison']
        ], params[:voice_type]),
        {},
        { class: "filter-select", data: { action: submit_action } }
    %>

    <%# Language %>
    <%= f.select :language,
        options_for_select([
          [t('filters.all_languages'), ''],
          [t('languages.latin'), 'Latin'],
          [t('languages.english'), 'English'],
          [t('languages.german'), 'German'],
          [t('languages.italian'), 'Italian'],
          [t('languages.french'), 'French'],
          [t('languages.spanish'), 'Spanish']
        ], params[:language]),
        {},
        { class: "filter-select", data: { action: submit_action } }
    %>
  </div>

</div>
