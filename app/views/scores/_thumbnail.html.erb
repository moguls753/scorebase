<% badge = score_card_badge(score) %>
<div class="aspect-square bg-[var(--color-bg)] flex items-center justify-center overflow-hidden relative">
  <span class="score-card-badge score-card-badge--<%= badge[:type] %>"><%= badge[:text] %></span>

  <% if score.has_thumbnail? %>
    <%= image_tag score.thumbnail,
        alt: score.display_title,
        class: "w-full h-full object-cover object-top"
    %>
  <% else %>
    <div class="text-6xl text-[var(--color-border-subtle)]">♪</div>
  <% end %>
</div>
