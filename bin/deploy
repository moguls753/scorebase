#!/usr/bin/env bash
set -euo pipefail

mkdir -p .kamal
cat > .kamal/secrets <<EOF
RAILS_MASTER_KEY=${RAILS_MASTER_KEY:?required}
KAMAL_REGISTRY_PASSWORD=${KAMAL_REGISTRY_PASSWORD:?required}
DEEPSEEK_API_KEY=${DEEPSEEK_API_KEY:?required}
SENTRY_DSN=$(bin/rails credentials:fetch sentry.dsn)
EOF

exec bin/kamal deploy "$@"
