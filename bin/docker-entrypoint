#!/bin/bash -e

# The directory link serves index-mode child files once the sitemap passes 50k URLs.
mkdir -p storage/sitemaps
ln -sf ../storage/sitemaps/sitemap.xml.gz public/sitemap.xml.gz
ln -sfn ../storage/sitemaps public/sitemaps

# If running the rails server then create or migrate existing database
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare
fi

exec "${@}"
